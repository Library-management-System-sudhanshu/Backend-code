# Express runs on your laptop. Copy the Session pooler URI from Supabase > Connect.
# Replace every placeholder; URL-encode special characters in the DB password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres
DB_SSL=true
# Optional downloaded database CA certificate, e.g. ./certs/prod-supabase.cer
DB_SSL_CA_PATH=

PORT=3000
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# First startup creates missing tables and runs the existing status-enum cleanup.
# After initial setup, use false to skip schema changes during normal startup.
DB_SYNC=true

# Enable on only one running server to avoid duplicate reminders.
CRON_ENABLED=false

# Optional integrations: Firebase can also use firebase-service-account.json.
FIREBASE_SERVICE_ACCOUNT=
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=default

# Required for Google login; fixed/mock OTP login is disabled until an SMS provider is configured.
GOOGLE_CLIENT_ID=
# Razorpay test keys are supported; never use hardcoded fallback keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
